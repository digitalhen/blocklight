{
  "name": "blocklight",
  "version": "0.1.0",
  "description": "Beautiful cities. Your data. A composable city mapping toolkit for MapLibre.",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./nyc": {
      "types": "./dist/nyc.d.ts",
      "import": "./dist/nyc.js"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/assets.mjs"
  },
  "peerDependencies": {
    "maplibre-gl": "^6.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "maplibre-gl": "^6.10.0",
    "react": "^19.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/digitalhen/blocklight.git",
    "directory": "packages/blocklight"
  },
  "homepage": "https://github.com/digitalhen/blocklight#readme",
  "bugs": {
    "url": "https://github.com/digitalhen/blocklight/issues"
  }
}
